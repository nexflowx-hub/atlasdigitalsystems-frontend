# Public site
NEXT_PUBLIC_SITE_URL=https://atlasdigitalsystems.co
NEXT_PUBLIC_DEFAULT_LOCALE=en-US
NEXT_PUBLIC_DEFAULT_COUNTRY=US
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Company — fill only with verified public corporate information
NEXT_PUBLIC_DELAWARE_FILE_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_PHONE=+13025955455
NEXT_PUBLIC_GENERAL_EMAIL=hello@atlasdigitalsystems.co
NEXT_PUBLIC_SUPPORT_EMAIL=support@atlasdigitalsystems.co
NEXT_PUBLIC_SALES_EMAIL=sales@atlasdigitalsystems.co
NEXT_PUBLIC_BILLING_EMAIL=billing@atlasdigitalsystems.co
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@atlasdigitalsystems.co
NEXT_PUBLIC_SECURITY_EMAIL=security@atlasdigitalsystems.co
NEXT_PUBLIC_LEGAL_EMAIL=legal@atlasdigitalsystems.co
NEXT_PUBLIC_DEVELOPERS_EMAIL=developers@atlasdigitalsystems.co

# Social — leave blank until an official Atlas account exists
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Application mode
APP_MODE=mock
PAYMENT_PROVIDER=stripe
CONTACT_PROVIDER=mock
AI_PROVIDER=mock

# Public mock checkout is OFF by default. Enable only in a controlled dev/preview environment.
NEXT_PUBLIC_ENABLE_MOCK_CHECKOUT=false

# Stripe — server secrets must be configured in Vercel, never committed
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false

# Stripe Price IDs — populate after products/prices exist in the Atlas Stripe account
STRIPE_PRICE_ATLAS_AI_PRO_USD=
STRIPE_PRICE_ATLAS_AI_BUSINESS_USD=
STRIPE_PRICE_ATLAS_AUTOMATE_USD=
STRIPE_PRICE_ATLAS_DATA_USD=
STRIPE_PRICE_BUSINESS_AUTOMATION_PACK_USD=
STRIPE_PRICE_AI_BUSINESS_TOOLKIT_USD=
STRIPE_PRICE_STARTUP_LAUNCH_SYSTEM_USD=
STRIPE_PRICE_MARKETING_AUTOMATION_KIT_USD=
STRIPE_PRICE_SALES_SYSTEM_USD=
STRIPE_PRICE_BUSINESS_OS_USD=

# Email / contact provider
RESEND_API_KEY=
